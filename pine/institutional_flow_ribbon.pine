//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  INSTITUTIONAL FLOW RIBBON  —  Kurumsal Para Akışı Şeridi
//  ---------------------------------------------------------------------------
//  Amaç : 7 EMA'yı ekrana ayrı ayrı çizmek yerine TEK bir şeride indirgemek ve
//         sadece renk değişimiyle (yeşil = long, kırmızı = short, gri = nötr)
//         sinyal üretmek. Sinyal kirliliği yok, bar başına tekrar eden giriş yok.
//  Mantık: 1) Hizalanma skoru (fiyat konumu + EMA dizilimi) -100..+100
//          2) Kurumsal para akışı onayı (CVD / OBV / RVOL / MFI / VWAP)
//          3) Multi-timeframe onayı (mevcut TF + HTF1 + HTF2, repaint'siz)
//          4) ATR tabanlı risk yönetimi (SL / TP / trailing / reverse)
//  Not   : Tüm HTF verileri KAPANMIŞ barlardan alınır -> repaint yoktur.
// ═══════════════════════════════════════════════════════════════════════════════

strategy(title = "Institutional Flow Ribbon | Kurumsal Akış Stratejisi",
     shorttitle              = "IFR",
     overlay                 = true,
     initial_capital         = 10000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 10,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.05,
     slippage                = 2,
     pyramiding              = 0,
     calc_on_every_tick      = false,
     calc_on_order_fills     = false,
     max_bars_back           = 1000,
     max_labels_count        = 500)

// ═══════════════════════════════════════════════════════════════════════════════
//  1. GRUP — MA AYARLARI (Tek Şerit)
// ═══════════════════════════════════════════════════════════════════════════════
string G_MA = "① MA Ayarları (Tek Şerit)"

maSrc      = input.source(close, "Kaynak",                                  group = G_MA)
wPrice     = input.int(50,  "Fiyat Konumu Ağırlığı (%)", minval = 0, maxval = 100, step = 5, group = G_MA, tooltip = "Skorun yüzde kaçı 'fiyat EMA'nın üstünde mi' bileşeninden gelsin. Kalanı EMA dizilim (fan) bileşenidir.")
thUp       = input.float(40, "Yeşil Eşiği (Long)",  minval = 0,   maxval = 100, step = 5, group = G_MA)
thDn       = input.float(-40,"Kırmızı Eşiği (Short)", minval = -100, maxval = 0, step = 5, group = G_MA)
weightMode = input.string("Hızlıya Ağırlıklı", "Şerit Ağırlık Modu", options = ["Hızlıya Ağırlıklı", "Eşit"], group = G_MA, tooltip = "Baseline çizgisinin EMA'ları nasıl harmanlayacağı. Hızlıya ağırlıklı = daha tepkisel.")
showFill   = input.bool(true, "Şerit Altına Fill Ekle", group = G_MA)
glowMult   = input.float(0.35, "Fill Kalınlığı (ATR ×)", minval = 0.05, maxval = 2.0, step = 0.05, group = G_MA)

// EMA seti — her biri tek tek açılıp kapanabilir
use1 = input.bool(true,  "EMA 1",  inline = "e1", group = G_MA)
len1 = input.int(8,      "",       inline = "e1", minval = 1, group = G_MA)
use2 = input.bool(true,  "EMA 2",  inline = "e2", group = G_MA)
len2 = input.int(13,     "",       inline = "e2", minval = 1, group = G_MA)
use3 = input.bool(true,  "EMA 3",  inline = "e3", group = G_MA)
len3 = input.int(21,     "",       inline = "e3", minval = 1, group = G_MA)
use4 = input.bool(true,  "EMA 4",  inline = "e4", group = G_MA)
len4 = input.int(34,     "",       inline = "e4", minval = 1, group = G_MA)
use5 = input.bool(true,  "EMA 5",  inline = "e5", group = G_MA)
len5 = input.int(55,     "",       inline = "e5", minval = 1, group = G_MA)
use6 = input.bool(true,  "EMA 6",  inline = "e6", group = G_MA)
len6 = input.int(89,     "",       inline = "e6", minval = 1, group = G_MA)
use7 = input.bool(true,  "EMA 7",  inline = "e7", group = G_MA)
len7 = input.int(200,    "",       inline = "e7", minval = 1, group = G_MA)

// ═══════════════════════════════════════════════════════════════════════════════
//  2. GRUP — KURUMSAL PARA AKIŞI (Smart Money)
// ═══════════════════════════════════════════════════════════════════════════════
string G_SM = "② Kurumsal Para Akışı"

minConfirm = input.int(3, "Gereken Minimum Onay Sayısı", minval = 1, maxval = 5, group = G_SM, tooltip = "Aşağıdaki aktif filtrelerden en az kaç tanesi sinyal yönünü desteklemeli.")
useCvd     = input.bool(true, "CVD Yönü",                inline = "s1", group = G_SM)
cvdLen     = input.int(21, "EMA",                        inline = "s1", minval = 2, group = G_SM)
useObv     = input.bool(true, "OBV Eğimi",               inline = "s2", group = G_SM)
obvLen     = input.int(21, "EMA",                        inline = "s2", minval = 2, group = G_SM)
useRvol    = input.bool(true, "Relative Volume",         inline = "s3", group = G_SM)
rvolLen    = input.int(20, "SMA",                        inline = "s3", minval = 2, group = G_SM)
volMult    = input.float(1.5, "Hacim Çarpanı", minval = 0.1, step = 0.1, group = G_SM)
useMfi     = input.bool(true, "MFI",                     inline = "s4", group = G_SM)
mfiLen     = input.int(14, "Uzunluk",                    inline = "s4", minval = 2, group = G_SM)
useVwap    = input.bool(true, "Session VWAP Konumu", group = G_SM, tooltip = "Hacim verisi olmayan sembollerde bu filtreyi kapatın.")

// ═══════════════════════════════════════════════════════════════════════════════
//  3. GRUP — MULTI TIMEFRAME
// ═══════════════════════════════════════════════════════════════════════════════
string G_TF = "③ Multi-Timeframe Onayı"

useMtf        = input.bool(true, "MTF Onayını Kullan", group = G_TF)
htf1          = input.timeframe("60",  "HTF 1", group = G_TF)
htf2          = input.timeframe("240", "HTF 2", group = G_TF)
mtfMode       = input.string("Sıkı (Strict)", "MTF Modu", options = ["Sıkı (Strict)", "Gevşek (Loose)"], group = G_TF, tooltip = "Sıkı: her iki HTF de aynı renkte olmalı. Gevşek: HTF'ler ters renkte olmasın (nötr kabul edilir).")
htfUseClosed  = input.bool(true, "Sadece Kapanmış HTF Barı (repaint kapalı)", group = G_TF, tooltip = "AÇIK bırakın. Kapatırsanız sinyaller bar içinde değişebilir (repaint).")
showTable     = input.bool(true, "MTF Panelini Göster", group = G_TF)

// ═══════════════════════════════════════════════════════════════════════════════
//  4. GRUP — RİSK YÖNETİMİ
// ═══════════════════════════════════════════════════════════════════════════════
string G_RK = "④ Risk Yönetimi"

allowLong     = input.bool(true, "Long İşlemler",  inline = "d", group = G_RK)
allowShort    = input.bool(true, "Short İşlemler", inline = "d", group = G_RK)
flipOnly      = input.bool(true, "Sadece Renk Dönüş Barında Gir", group = G_RK, tooltip = "Açık: sinyal yalnızca şerit renginin değiştiği barda üretilir. Kapalı: renk zaten yeşilken onaylar tamamlandığı ilk barda da girer.")
atrLen        = input.int(14, "ATR Uzunluğu", minval = 1, group = G_RK)
atrMult       = input.float(1.5, "Stop Loss (ATR ×)", minval = 0.1, step = 0.1, group = G_RK)
useTp         = input.bool(true, "Take Profit Kullan", group = G_RK)
rrRatio       = input.float(2.0, "Risk / Reward Oranı", minval = 0.1, step = 0.1, group = G_RK)
useTrail      = input.bool(false, "Trailing Stop Kullan", group = G_RK)
trailActMult  = input.float(1.0, "Trailing Aktivasyon (ATR ×)", minval = 0.1, step = 0.1, group = G_RK)
trailOffMult  = input.float(0.7, "Trailing Mesafe (ATR ×)",     minval = 0.1, step = 0.1, group = G_RK)
allowReverse  = input.bool(true, "Ters Sinyalde Pozisyonu Döndür (Reverse)", group = G_RK)
exitOnNeutral = input.bool(false, "Şerit Nötre Dönünce Kapat", group = G_RK, tooltip = "Açık: rengin nötre/tersine dönmesi tek başına çıkış sebebidir (SL/TP beklenmez).")

// ═══════════════════════════════════════════════════════════════════════════════
//  5. GRUP — SIKIŞMA (YATAY PİYASA) FİLTRESİ
//  Stratejinin en zayıf noktası yatay piyasadır: EMA'lar iç içe geçer, skor
//  eşiklerin etrafında salınır ve arka arkaya küçük zararlı işlemler (whipsaw)
//  üretir. Bu filtre sıkışma tespit ettiğinde skoru ZORLA nötre çevirir, yani
//  şerit gri kalır ve o bölgede hiç işlem açılmaz.
// ═══════════════════════════════════════════════════════════════════════════════
string G_SQ = "⑤ Sıkışma (Yatay Piyasa) Filtresi"

useSqueeze   = input.bool(true, "Sıkışma Filtresini Kullan", group = G_SQ, tooltip = "Kapatırsanız strateji bu filtre eklenmeden önceki davranışına döner.")
sqMode       = input.string("Herhangi biri (OR)", "Tespit Yöntemi", options = ["ADX", "BBW", "İkisi de (AND)", "Herhangi biri (OR)"], group = G_SQ, tooltip = "OR = en sıkı eleme (ikisinden biri sıkışma derse işlem yok). AND = en gevşek. Tek başına ADX klasik seçimdir.")
adxLen       = input.int(14, "ADX / DI Uzunluğu", minval = 1, group = G_SQ)
adxSmooth    = input.int(14, "ADX Yumuşatma",     minval = 1, group = G_SQ)
adxTh        = input.float(20, "ADX Eşiği (altı = trendsiz)", minval = 5, maxval = 50, step = 1, group = G_SQ)
bbLen        = input.int(20, "Bollinger Uzunluğu", minval = 2, group = G_SQ)
bbMult       = input.float(2.0, "Bollinger Çarpanı", minval = 0.1, step = 0.1, group = G_SQ)
bbwLook      = input.int(120, "BBW Geriye Bakış", minval = 10, group = G_SQ, tooltip = "Bant genişliğinin kaç barlık geçmişe göre değerlendirileceği.")
bbwPct       = input.float(20, "BBW Yüzdelik Eşiği", minval = 1, maxval = 99, step = 1, group = G_SQ, tooltip = "Bant genişliği son N barın en dar %X'i içindeyse sıkışma sayılır.")
showSqueezeBg = input.bool(true, "Sıkışma Bölgesini Arka Planda Göster", group = G_SQ)

// ═══════════════════════════════════════════════════════════════════════════════
//  RENKLER
// ═══════════════════════════════════════════════════════════════════════════════
color C_BULL = color.new(#26A69A, 0)   // yeşil  — kurumsal alım baskısı
color C_BEAR = color.new(#EF5350, 0)   // kırmızı — kurumsal satış baskısı
color C_FLAT = color.new(#787B86, 0)   // gri     — nötr, işlem yok

// ═══════════════════════════════════════════════════════════════════════════════
//  ÇEKİRDEK FONKSİYONLAR
//  (Bu fonksiyonlar hem mevcut TF'de hem request.security içinde kullanılır;
//   böylece kod tekrarı olmaz ve her TF'de tamamen aynı mantık çalışır.)
// ═══════════════════════════════════════════════════════════════════════════════

// Hizalanma skoru: -100 (tam düşüş dizilimi) ... +100 (tam yükseliş dizilimi)
f_alignScore() =>
    // EMA'lar KOŞULSUZ hesaplanır — ta.* fonksiyonları her barda çalışmalıdır,
    // aksi halde iç durumları (history) bozulur.
    float e1 = ta.ema(maSrc, len1)
    float e2 = ta.ema(maSrc, len2)
    float e3 = ta.ema(maSrc, len3)
    float e4 = ta.ema(maSrc, len4)
    float e5 = ta.ema(maSrc, len5)
    float e6 = ta.ema(maSrc, len6)
    float e7 = ta.ema(maSrc, len7)

    // Sadece AKTİF EMA'lar hızlıdan yavaşa doğru diziye alınır
    arr = array.new_float()
    if use1
        array.push(arr, e1)
    if use2
        array.push(arr, e2)
    if use3
        array.push(arr, e3)
    if use4
        array.push(arr, e4)
    if use5
        array.push(arr, e5)
    if use6
        array.push(arr, e6)
    if use7
        array.push(arr, e7)
    int n = array.size(arr)

    // ── Bileşen 1: Fiyat konumu (her EMA için +1 / -1) ────────────────────────
    float pSum = 0.0
    if n > 0
        for i = 0 to n - 1
            pSum += (maSrc > array.get(arr, i) ? 1.0 : -1.0)
    float pNorm = n > 0 ? pSum / n * 100.0 : 0.0

    // ── Bileşen 2: Dizilim / fan sırası (8>13>21>... doğru mu?) ───────────────
    float oSum = 0.0
    if n > 1
        for i = 0 to n - 2
            oSum += (array.get(arr, i) > array.get(arr, i + 1) ? 1.0 : -1.0)
    float oNorm = n > 1 ? oSum / (n - 1) * 100.0 : 0.0

    // Ağırlıklı birleşim -> tek skor
    float w = wPrice / 100.0
    float sc = pNorm * w + oNorm * (1.0 - w)
    sc

// Tek çizgi (baseline): aktif EMA'ların ağırlıklı ortalaması
f_baseline() =>
    float e1 = ta.ema(maSrc, len1)
    float e2 = ta.ema(maSrc, len2)
    float e3 = ta.ema(maSrc, len3)
    float e4 = ta.ema(maSrc, len4)
    float e5 = ta.ema(maSrc, len5)
    float e6 = ta.ema(maSrc, len6)
    float e7 = ta.ema(maSrc, len7)

    bool eq = weightMode == "Eşit"
    // "Hızlıya Ağırlıklı" modda ağırlık = 1/periyot (kısa EMA daha baskın)
    float w1 = eq ? 1.0 : 1.0 / len1
    float w2 = eq ? 1.0 : 1.0 / len2
    float w3 = eq ? 1.0 : 1.0 / len3
    float w4 = eq ? 1.0 : 1.0 / len4
    float w5 = eq ? 1.0 : 1.0 / len5
    float w6 = eq ? 1.0 : 1.0 / len6
    float w7 = eq ? 1.0 : 1.0 / len7

    float vs = 0.0
    float ws = 0.0
    if use1
        vs += e1 * w1
        ws += w1
    if use2
        vs += e2 * w2
        ws += w2
    if use3
        vs += e3 * w3
        ws += w3
    if use4
        vs += e4 * w4
        ws += w4
    if use5
        vs += e5 * w5
        ws += w5
    if use6
        vs += e6 * w6
        ws += w6
    if use7
        vs += e7 * w7
        ws += w7
    ws > 0 ? vs / ws : maSrc

// HTF için: skoru fonksiyonun İÇİNDE bir bar geri kaydırıyoruz.
// request.security dışarıdan [1] almak chart barını kaydırır; burada ise
// HTF'nin KAPANMIŞ barı alınır -> repaint yok.
f_alignScoreClosed() =>
    float s  = f_alignScore()
    float sp = s[1]
    htfUseClosed ? sp : s

// Skoru üç duruma indirger: 1 = yeşil, -1 = kırmızı, 0 = nötr
f_state(float sc) =>
    sc >= thUp ? 1 : sc <= thDn ? -1 : 0

// Durum -> renk / metin yardımcıları (panel için)
f_stateCol(int st) =>
    st == 1 ? C_BULL : st == -1 ? C_BEAR : C_FLAT

f_stateTxt(int st) =>
    st == 1 ? "YÜKSELİŞ" : st == -1 ? "DÜŞÜŞ" : "NÖTR"

// Webhook uyumlu JSON mesajı
f_json(string act, float px, float sl, float tp, float sc) =>
    '{"action":"' + act + '","ticker":"' + syminfo.ticker + '","exchange":"' + syminfo.exchange + '","tf":"' + timeframe.period + '","price":' + str.tostring(px, format.mintick) + ',"sl":' + str.tostring(sl, format.mintick) + ',"tp":' + str.tostring(tp, format.mintick) + ',"score":' + str.tostring(sc, "#.##") + ',"time":' + str.tostring(time) + '}'

// ═══════════════════════════════════════════════════════════════════════════════
//  MEVCUT TIMEFRAME HESAPLARI
// ═══════════════════════════════════════════════════════════════════════════════
float scoreCur = f_alignScore()
float baseline = f_baseline()
float atrVal   = ta.atr(atrLen)

// ── SIKIŞMA TESPİTİ ──────────────────────────────────────────────────────────
// 1) ADX: trend gücü ölçer, eşiğin altı "yön yok" demektir.
[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxSmooth)
bool adxSq = not na(adxVal) and adxVal < adxTh

// 2) BBW: Bollinger bant genişliği son N barın en dar %X'i içindeyse sıkışma.
float bbBasis  = ta.sma(close, bbLen)
float bbDev    = bbMult * ta.stdev(close, bbLen)
float bbw      = bbBasis != 0 ? bbDev * 2 / bbBasis * 100 : 0.0
float bbwLimit = ta.percentile_nearest_rank(bbw, bbwLook, bbwPct)
// na kontrolleri: ısınma barlarında sıkışma durumunun na'ya kayıp stCur'u
// bozmasını engeller (na bir int, sonraki tüm karşılaştırmaları kirletirdi)
bool  bbwSq    = not na(bbwLimit) and not na(bbw) and bbw <= bbwLimit

bool sqRaw   = sqMode == "ADX" ? adxSq : sqMode == "BBW" ? bbwSq : sqMode == "İkisi de (AND)" ? (adxSq and bbwSq) : (adxSq or bbwSq)
bool squeeze = useSqueeze and sqRaw

// Sıkışma varsa skor ne olursa olsun şerit GRİ (nötr) kabul edilir -> işlem yok.
// Sıkışma çözüldüğünde griden yeşile/kırmızıya geçiş doğal bir renk dönüşü
// üretir; yani kırılım barı zaten sinyal olarak yakalanır.
int stCur = squeeze ? 0 : f_state(scoreCur)

// ═══════════════════════════════════════════════════════════════════════════════
//  MULTI-TIMEFRAME (barmerge.lookahead_off ZORUNLU — geleceğe bakma yok)
// ═══════════════════════════════════════════════════════════════════════════════
float scoreH1 = request.security(syminfo.tickerid, htf1, f_alignScoreClosed(), lookahead = barmerge.lookahead_off)
float scoreH2 = request.security(syminfo.tickerid, htf2, f_alignScoreClosed(), lookahead = barmerge.lookahead_off)
int   stH1    = f_state(nz(scoreH1))
int   stH2    = f_state(nz(scoreH2))

// Sıkı mod: her iki HTF de aynı renkte olmalı
// Gevşek mod: HTF'ler ters renkte OLMASIN (nötr kabul edilir)
bool strictMtf  = mtfMode == "Sıkı (Strict)"
bool mtfLongOk  = (not useMtf) or (strictMtf ? (stH1 == 1 and stH2 == 1) : (stH1 >= 0 and stH2 >= 0))
bool mtfShortOk = (not useMtf) or (strictMtf ? (stH1 == -1 and stH2 == -1) : (stH1 <= 0 and stH2 <= 0))

// ═══════════════════════════════════════════════════════════════════════════════
//  KURUMSAL PARA AKIŞI FİLTRELERİ
// ═══════════════════════════════════════════════════════════════════════════════

// ── CVD (Cumulative Volume Delta) ────────────────────────────────────────────
// Bar içi alıcı/satıcı hacmi, kapanışın bar aralığındaki konumuyla ayrıştırılır.
float rng    = high - low
float upVol  = rng > 0 ? nz(volume) * (close - low) / rng : 0.0
float dnVol  = rng > 0 ? nz(volume) * (high - close) / rng : 0.0
float cvd    = ta.cum(upVol - dnVol)
float cvdSig = ta.ema(cvd, cvdLen)
bool  cvdBull = cvd > cvdSig
bool  cvdBear = cvd < cvdSig

// ── OBV eğimi ────────────────────────────────────────────────────────────────
// ta.obv yerine manuel hesap: hacim verisi olmayan sembollerde runtime hatası
// fırlatmaz, scriptin tamamını durdurmaz.
var float obvVal = 0.0
obvVal += (close > nz(close[1], close) ? nz(volume) : close < nz(close[1], close) ? -nz(volume) : 0.0)
float obvSig  = ta.ema(obvVal, obvLen)
bool  obvBull = obvVal > obvSig
bool  obvBear = obvVal < obvSig

// ── Relative Volume (yön bağımsız: kurumsal ilgi var mı?) ────────────────────
float volAvg = ta.sma(volume, rvolLen)
// nz(): hacimsiz sembollerde na yayılıp onay sayacını bozmasın
bool  rvolOk = nz(volume) > nz(volAvg) * volMult

// ── MFI(14) ──────────────────────────────────────────────────────────────────
// ta.mfi() ile birebir aynı formül; hacimsiz sembollerde hata vermemesi için
// nz(volume) ile elle yazıldı, veri yoksa nötr 50 döner.
float mfSrc   = hlc3
float posFlow = ta.rma(mfSrc > nz(mfSrc[1], mfSrc) ? mfSrc * nz(volume) : 0.0, mfiLen)
float negFlow = ta.rma(mfSrc < nz(mfSrc[1], mfSrc) ? mfSrc * nz(volume) : 0.0, mfiLen)
float mfiVal  = posFlow + negFlow == 0 ? 50.0 : negFlow == 0 ? 100.0 : 100.0 - 100.0 / (1.0 + posFlow / negFlow)
bool  mfiBull = mfiVal > 50
bool  mfiBear = mfiVal < 50

// ── Session VWAP ─────────────────────────────────────────────────────────────
// Her yeni günde sıfırlanan seans VWAP'ı. ta.vwap() hacimsiz sembollerde
// scripti hata ile durdurduğu için burada elle hesaplanır.
bool newSession = timeframe.change("D")
var float cumPV = 0.0
var float cumV  = 0.0
if newSession
    cumPV := 0.0
    cumV  := 0.0
cumPV += hlc3 * nz(volume)
cumV  += nz(volume)
float vwapVal  = cumV > 0 ? cumPV / cumV : hlc3
bool  vwapBull = close > vwapVal
bool  vwapBear = close < vwapVal

// Onay sayacı — aktif filtre sayısını aşan minConfirm değerleri otomatik kırpılır
int activeCnt = (useCvd ? 1 : 0) + (useObv ? 1 : 0) + (useRvol ? 1 : 0) + (useMfi ? 1 : 0) + (useVwap ? 1 : 0)
int needCnt   = math.min(minConfirm, math.max(activeCnt, 1))

int smLongCnt  = (useCvd and cvdBull ? 1 : 0) + (useObv and obvBull ? 1 : 0) + (useRvol and rvolOk ? 1 : 0) + (useMfi and mfiBull ? 1 : 0) + (useVwap and vwapBull ? 1 : 0)
int smShortCnt = (useCvd and cvdBear ? 1 : 0) + (useObv and obvBear ? 1 : 0) + (useRvol and rvolOk ? 1 : 0) + (useMfi and mfiBear ? 1 : 0) + (useVwap and vwapBear ? 1 : 0)

bool smLongOk  = activeCnt == 0 or smLongCnt  >= needCnt
bool smShortOk = activeCnt == 0 or smShortCnt >= needCnt

// ═══════════════════════════════════════════════════════════════════════════════
//  SİNYAL ÜRETİMİ  (yalnızca DURUM DEĞİŞİMİNDE — her barda değil)
// ═══════════════════════════════════════════════════════════════════════════════
bool longRegime  = stCur == 1  and mtfLongOk  and smLongOk
bool shortRegime = stCur == -1 and mtfShortOk and smShortOk

// Şerit renginin tam bu barda döndüğü an
bool flipUp   = stCur == 1  and nz(stCur[1]) != 1
bool flipDown = stCur == -1 and nz(stCur[1]) != -1

// flipOnly AÇIK  -> sadece renk dönüş barı (en temiz, en az sinyal)
// flipOnly KAPALI-> renk zaten doğruyken onayların tamamlandığı ilk bar da geçerli
bool longTrigger  = allowLong  and (flipOnly ? (flipUp   and mtfLongOk  and smLongOk)  : (longRegime  and not longRegime[1]))
bool shortTrigger = allowShort and (flipOnly ? (flipDown and mtfShortOk and smShortOk) : (shortRegime and not shortRegime[1]))

// ═══════════════════════════════════════════════════════════════════════════════
//  EMİRLER
// ═══════════════════════════════════════════════════════════════════════════════

// Sinyal barındaki projeksiyon seviyeleri (alert mesajı için)
float projSlLong  = close - atrVal * atrMult
float projTpLong  = close + atrVal * atrMult * rrRatio
float projSlShort = close + atrVal * atrMult
float projTpShort = close - atrVal * atrMult * rrRatio

// Sinyal anındaki ATR saklanır; emir bir sonraki barın açılışında dolduğu için
// stop/hedef mesafesi sinyalin üretildiği bardaki volatiliteye göre sabitlenir.
var float pendingAtr = na
if longTrigger or shortTrigger
    pendingAtr := atrVal

// Reverse kapalıysa yalnızca düz (flat) pozisyondayken girilir.
bool canEnterLong  = longTrigger  and (allowReverse or strategy.position_size == 0)
bool canEnterShort = shortTrigger and (allowReverse or strategy.position_size == 0)

if canEnterLong
    strategy.entry("LONG", strategy.long, comment = "L", alert_message = f_json("buy", close, projSlLong, projTpLong, scoreCur))

if canEnterShort
    strategy.entry("SHORT", strategy.short, comment = "S", alert_message = f_json("sell", close, projSlShort, projTpShort, scoreCur))

// ── Pozisyon açıldığında SL / TP seviyelerini SABİTLE ────────────────────────
var float stopPx = na
var float tpPx   = na

int posSign = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
// flat -> long, flat -> short ve short -> long (reverse) geçişlerinin hepsini yakalar
bool newPos = posSign != 0 and posSign != nz(posSign[1])

if newPos
    float entryPx = strategy.position_avg_price
    float a       = nz(pendingAtr, atrVal)
    stopPx := posSign > 0 ? entryPx - a * atrMult : entryPx + a * atrMult
    float riskDist = math.abs(entryPx - stopPx)
    tpPx := posSign > 0 ? entryPx + riskDist * rrRatio : entryPx - riskDist * rrRatio

if posSign == 0
    stopPx := na
    tpPx   := na

// Trailing stop parametreleri tick cinsine çevrilir
float trailActTicks = atrVal * trailActMult / syminfo.mintick
float trailOffTicks = atrVal * trailOffMult / syminfo.mintick

// ── Çıkış emirleri (her barda güncellenir, aynı ID olduğu için tek emirdir) ──
if strategy.position_size > 0
    strategy.exit("L-Exit", from_entry = "LONG", stop = stopPx, limit = useTp ? tpPx : na, trail_points = useTrail ? trailActTicks : na, trail_offset = useTrail ? trailOffTicks : na, alert_message = f_json("close_long", close, nz(stopPx), nz(tpPx), scoreCur))

if strategy.position_size < 0
    strategy.exit("S-Exit", from_entry = "SHORT", stop = stopPx, limit = useTp ? tpPx : na, trail_points = useTrail ? trailActTicks : na, trail_offset = useTrail ? trailOffTicks : na, alert_message = f_json("close_short", close, nz(stopPx), nz(tpPx), scoreCur))

// ── Şerit nötre/tersine dönünce kapat (opsiyonel) ────────────────────────────
if exitOnNeutral and strategy.position_size > 0 and stCur != 1
    strategy.close("LONG", comment = "Renk Kaybı", alert_message = f_json("close_long", close, nz(stopPx), nz(tpPx), scoreCur))

if exitOnNeutral and strategy.position_size < 0 and stCur != -1
    strategy.close("SHORT", comment = "Renk Kaybı", alert_message = f_json("close_short", close, nz(stopPx), nz(tpPx), scoreCur))

// ═══════════════════════════════════════════════════════════════════════════════
//  GÖRSELLEŞTİRME — TEK ŞERİT
// ═══════════════════════════════════════════════════════════════════════════════
color ribbonCol = f_stateCol(stCur)

plotBase = plot(baseline, "Kurumsal Şerit", color = ribbonCol, linewidth = 3)
// Fill için görünmez ikinci çizgi (şeridin hemen altında, ATR ölçekli)
plotGlow = plot(showFill ? baseline - atrVal * glowMult : na, "Fill Sınırı", color = color.new(ribbonCol, 100), editable = false)
fill(plotBase, plotGlow, color = color.new(ribbonCol, 85), title = "Şerit Gölgesi")

// Sıkışma bölgesi — çok hafif gri tarama, sinyal kirliliği yaratmayacak yoğunlukta
bgcolor(squeeze and showSqueezeBg ? color.new(color.gray, 90) : na, title = "Sıkışma Bölgesi")

// Sinyal etiketleri
plotshape(longTrigger,  title = "LONG Sinyali",  style = shape.labelup,   location = location.belowbar, color = C_BULL, textcolor = color.white, text = "LONG",  size = size.small)
plotshape(shortTrigger, title = "SHORT Sinyali", style = shape.labeldown, location = location.abovebar, color = C_BEAR, textcolor = color.white, text = "SHORT", size = size.small)

// ═══════════════════════════════════════════════════════════════════════════════
//  MTF DURUM PANELİ (sağ üst köşe)
// ═══════════════════════════════════════════════════════════════════════════════
var table panel = table.new(position.top_right, 2, 8, border_width = 1, frame_color = color.new(color.gray, 60), frame_width = 1)

if showTable and barstate.islast
    table.cell(panel, 0, 0, "KURUMSAL AKIŞ", bgcolor = color.new(color.black, 20), text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 0, "IFR",           bgcolor = color.new(color.black, 20), text_color = color.white, text_size = size.small)

    table.cell(panel, 0, 1, "Mevcut " + timeframe.period, bgcolor = color.new(color.gray, 85), text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 1, f_stateTxt(stCur), bgcolor = f_stateCol(stCur), text_color = color.white, text_size = size.small)

    table.cell(panel, 0, 2, "HTF1 " + htf1, bgcolor = color.new(color.gray, 85), text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 2, useMtf ? f_stateTxt(stH1) : "KAPALI", bgcolor = useMtf ? f_stateCol(stH1) : C_FLAT, text_color = color.white, text_size = size.small)

    table.cell(panel, 0, 3, "HTF2 " + htf2, bgcolor = color.new(color.gray, 85), text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 3, useMtf ? f_stateTxt(stH2) : "KAPALI", bgcolor = useMtf ? f_stateCol(stH2) : C_FLAT, text_color = color.white, text_size = size.small)

    table.cell(panel, 0, 4, "Skor", bgcolor = color.new(color.gray, 85), text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 4, str.tostring(scoreCur, "#.#"), bgcolor = color.new(f_stateCol(stCur), 60), text_color = color.white, text_size = size.small)

    table.cell(panel, 0, 5, "Akış L/S (min " + str.tostring(needCnt) + ")", bgcolor = color.new(color.gray, 85), text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 5, str.tostring(smLongCnt) + " / " + str.tostring(smShortCnt), bgcolor = color.new(smLongCnt >= needCnt ? C_BULL : smShortCnt >= needCnt ? C_BEAR : C_FLAT, 40), text_color = color.white, text_size = size.small)

    table.cell(panel, 0, 6, "Sıkışma", bgcolor = color.new(color.gray, 85), text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 6, not useSqueeze ? "KAPALI" : squeeze ? "VAR (ADX " + str.tostring(adxVal, "#.#") + ")" : "YOK", bgcolor = color.new(squeeze ? color.orange : C_FLAT, 40), text_color = color.white, text_size = size.small)

    table.cell(panel, 0, 7, "Pozisyon", bgcolor = color.new(color.gray, 85), text_color = color.white, text_size = size.small)
    table.cell(panel, 1, 7, posSign > 0 ? "LONG" : posSign < 0 ? "SHORT" : "YOK", bgcolor = color.new(f_stateCol(posSign), 40), text_color = color.white, text_size = size.small)

// ═══════════════════════════════════════════════════════════════════════════════
//  ALARMLAR
//  Not: alertcondition() bir strateji scriptinde DERLENİR, hata vermez — ancak
//  oluşturduğu koşul strateji scriptlerinde "Alarm Oluştur" penceresinde HİÇ
//  listelenmez, yani seçilip etkinleştirilemez. Sessizce çalışmayan kod olmasın
//  diye aşağıda yorum halinde bırakıldı; işlevsel alarmlar alert() iledir.
//  TradingView'de: Alarm Oluştur -> Koşul: bu strateji -> "Any alert() function call"
//  veya emir bazlı alarmlarda {{strategy.order.alert_message}} kullanın.
// ═══════════════════════════════════════════════════════════════════════════════
if longTrigger
    alert(f_json("buy", close, projSlLong, projTpLong, scoreCur), alert.freq_once_per_bar_close)

if shortTrigger
    alert(f_json("sell", close, projSlShort, projTpShort, scoreCur), alert.freq_once_per_bar_close)

// Şerit renk değişimi (pozisyondan bağımsız durum bilgisi)
if flipUp and not longTrigger
    alert('{"action":"info","event":"ribbon_green","ticker":"' + syminfo.ticker + '","tf":"' + timeframe.period + '"}', alert.freq_once_per_bar_close)

if flipDown and not shortTrigger
    alert('{"action":"info","event":"ribbon_red","ticker":"' + syminfo.ticker + '","tf":"' + timeframe.period + '"}', alert.freq_once_per_bar_close)

// ─── INDICATOR'A ÇEVİRİRSENİZ bu satırları açın (stratejide etkisizdirler) ───
// alertcondition(longTrigger,  title = "IFR LONG",  message = '{"action":"buy","ticker":"{{ticker}}","tf":"{{interval}}","price":"{{close}}"}')
// alertcondition(shortTrigger, title = "IFR SHORT", message = '{"action":"sell","ticker":"{{ticker}}","tf":"{{interval}}","price":"{{close}}"}')
