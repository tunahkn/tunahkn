//@version=6
// ═══════════════════════════════════════════════════════════════════════════════
//  IFR TRADER PRO — Rejim Farkindali Islem Sistemi
//  ---------------------------------------------------------------------------
//  Onceki surum tek bir barda BES kosulun birden saglanmasini istiyordu
//  (renk donusu + iki HTF + 3 para akisi onayi + sikisma yok + skor esigi).
//  Bes bagimsiz kosulun kesisimi pratikte hic olusmadigi icin sinyal uretmiyordu.
//
//  TEMEL ILKE: Kapi zinciri yok. Her modun TEK giris tetikleyicisi ve TEK
//  gecersizlik seviyesi (stop) vardir. Onay filtreleri veto degil, KALITE
//  SKORUDUR.
//
//  UC OYUN KITABI — piyasa rejimine gore biri calisir:
//    1) RANGE    : kutu kenarlarinda fade (ADX dusuk + fiyat kutu icinde)
//    2) BREAKOUT : kutu disina KAPANIS + hacim onayi (rejim gecisi)
//    3) TREND    : hizalanma seridi (yalnizca trend rejiminde)
// ═══════════════════════════════════════════════════════════════════════════════

strategy(title = "IFR Trader Pro", shorttitle = "IFR TRADER", overlay = true, initial_capital = 10000, default_qty_type = strategy.percent_of_equity, default_qty_value = 10, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 2, pyramiding = 0, calc_on_every_tick = false, max_bars_back = 500, max_labels_count = 200)

// ═══════════════════════════════════════════════════════════════════════════════
//  1. SERIT (MA) AYARLARI
// ═══════════════════════════════════════════════════════════════════════════════
G1 = "1. Serit (MA) Ayarlari"

wPrice = input.int(50, "Fiyat Konumu Agirligi (%)", minval = 0, maxval = 100, step = 5, group = G1)
thUp   = input.float(40, "Yesil Esigi (Long)", minval = 0, maxval = 100, step = 5, group = G1)
thDn   = input.float(-40, "Kirmizi Esigi (Short)", minval = -100, maxval = 0, step = 5, group = G1)
wMode  = input.string("Hizliya Agirlikli", "Serit Agirlik Modu", options = ["Hizliya Agirlikli", "Esit"], group = G1)

use1 = input.bool(true, "EMA 1", inline = "e1", group = G1)
len1 = input.int(8, "", inline = "e1", minval = 1, group = G1)
use2 = input.bool(true, "EMA 2", inline = "e2", group = G1)
len2 = input.int(13, "", inline = "e2", minval = 1, group = G1)
use3 = input.bool(true, "EMA 3", inline = "e3", group = G1)
len3 = input.int(21, "", inline = "e3", minval = 1, group = G1)
use4 = input.bool(true, "EMA 4", inline = "e4", group = G1)
len4 = input.int(34, "", inline = "e4", minval = 1, group = G1)
use5 = input.bool(true, "EMA 5", inline = "e5", group = G1)
len5 = input.int(55, "", inline = "e5", minval = 1, group = G1)
use6 = input.bool(true, "EMA 6", inline = "e6", group = G1)
len6 = input.int(89, "", inline = "e6", minval = 1, group = G1)
use7 = input.bool(true, "EMA 7", inline = "e7", group = G1)
len7 = input.int(200, "", inline = "e7", minval = 1, group = G1)

// ═══════════════════════════════════════════════════════════════════════════════
//  2. KURUMSAL PARA AKISI  (veto DEGIL — kalite skoru girdisi)
// ═══════════════════════════════════════════════════════════════════════════════
G2 = "2. Kurumsal Para Akisi"

useCvd  = input.bool(true, "CVD Yonu", inline = "s1", group = G2)
cvdLen  = input.int(21, "EMA", inline = "s1", minval = 2, group = G2)
useObv  = input.bool(true, "OBV Egimi", inline = "s2", group = G2)
obvLen  = input.int(21, "EMA", inline = "s2", minval = 2, group = G2)
useRvol = input.bool(true, "Relative Volume", inline = "s3", group = G2)
rvolLen = input.int(20, "SMA", inline = "s3", minval = 2, group = G2)
volMult = input.float(1.5, "Hacim Carpani (kirilim onayi da bunu kullanir)", minval = 0.1, step = 0.1, group = G2)
useMfi  = input.bool(true, "MFI", inline = "s4", group = G2)
mfiLen  = input.int(14, "Uzunluk", inline = "s4", minval = 2, group = G2)
useVwap = input.bool(true, "Session VWAP Konumu", group = G2)

// ═══════════════════════════════════════════════════════════════════════════════
//  3. MULTI-TIMEFRAME  (kalite puani — artik zorunlu kapi degil)
// ═══════════════════════════════════════════════════════════════════════════════
G3 = "3. Multi-Timeframe"

// HTF'ler ELLE secilir. Otomatik turetme kaldirildi: kullanici tanimli
// fonksiyonlarin donusu Pine'da DAIMA series'tir ve request.security()'nin
// zaman dilimi argumani SIMPLE olmak zorundadir (CE10123). input.timeframe()
// dogrudan simple uyumlu deger dondurur.
htf1      = input.timeframe("1D", "HTF 1", group = G3, tooltip = "Grafik zaman diliminden BUYUK olmali. 4 saatlik grafik icin 1D, 1 saatlik icin 240, 15 dakikalik icin 60.")
htf2      = input.timeframe("3D", "HTF 2", group = G3, tooltip = "HTF1 den de buyuk olmali. 4 saatlik grafik icin 3D, 1 saatlik icin 1D.")
noRepaint = input.bool(true, "Sadece Kapanmis HTF Bari (repaint kapali)", group = G3)

// ═══════════════════════════════════════════════════════════════════════════════
//  4. REJIM VE OYUN KITAPLARI
// ═══════════════════════════════════════════════════════════════════════════════
G4 = "4. Rejim ve Oyun Kitaplari"

useRegime = input.bool(true, "Rejim Tespitini Kullan", group = G4, tooltip = "Kapali = her zaman TREND modu (eski davranis).")
useRange  = input.bool(true, "RANGE modu (kenar fade)", group = G4)
useBreak  = input.bool(true, "BREAKOUT modu (kapanis + hacim)", group = G4)
useTrend  = input.bool(true, "TREND modu (serit)", group = G4)
boxLook   = input.int(120, "Kutu Geriye Bakis (bar)", minval = 20, group = G4, tooltip = "4 saatlikte 120 bar = 20 gun. Kutunun ust/alt siniri bu pencerenin uc degerleridir.")
edgePct   = input.float(15, "Kenar Bolgesi (kutu yuksekliginin %'si)", minval = 2, maxval = 40, step = 1, group = G4)
adxLen    = input.int(14, "ADX / DI Uzunlugu", minval = 1, group = G4)
adxSm     = input.int(14, "ADX Yumusatma", minval = 1, group = G4)
adxTh     = input.float(20, "ADX Esigi (alti = yatay rejim)", minval = 5, maxval = 50, step = 1, group = G4)

// ═══════════════════════════════════════════════════════════════════════════════
//  5. SINYAL KALITESI  (TREND modu icin)
// ═══════════════════════════════════════════════════════════════════════════════
G5 = "5. Sinyal Kalitesi"

flipWindow = input.int(3, "Renk Donus Penceresi (bar)", minval = 1, maxval = 20, group = G5, tooltip = "Serit son kac bar icinde donmus olmali. 1 = eski 'tam o bar' davranisi.")
qualityMin = input.int(3, "Minimum Kalite Puani (0-7)", minval = 0, maxval = 7, group = G5, tooltip = "MTF uyumu (0-2) + para akisi onaylari (0-5). Bu puanin altinda TREND girisi yok.")
useSqTrend = input.bool(true, "Sikisma TREND girisini engellesin", group = G5, tooltip = "Sikisma yalnizca TREND modunu susturur; RANGE modu zaten dusuk ADX'te calisir.")

// ═══════════════════════════════════════════════════════════════════════════════
//  6. RISK YONETIMI
// ═══════════════════════════════════════════════════════════════════════════════
G6 = "6. Risk Yonetimi"

allowLong  = input.bool(true, "Long", inline = "d", group = G6)
allowShort = input.bool(true, "Short", inline = "d", group = G6)
atrLen     = input.int(14, "ATR Uzunlugu", minval = 1, group = G6)
atrMult    = input.float(1.5, "TREND Stop (ATR x)", minval = 0.1, step = 0.1, group = G6)
rrRatio    = input.float(2.0, "TREND Risk / Reward", minval = 0.1, step = 0.1, group = G6)
stopPad    = input.float(0.5, "RANGE/BREAKOUT Stop Payi (ATR x)", minval = 0.0, step = 0.1, group = G6, tooltip = "Kutu sinirinin ne kadar disina stop konacagi.")
useTrail   = input.bool(false, "Trailing Stop", group = G6)
trailAct   = input.float(1.0, "Trailing Aktivasyon (ATR x)", minval = 0.1, step = 0.1, group = G6)
trailOff   = input.float(0.7, "Trailing Mesafe (ATR x)", minval = 0.1, step = 0.1, group = G6)
allowRev   = input.bool(true, "Ters Sinyalde Dondur (Reverse)", group = G6)

// ═══════════════════════════════════════════════════════════════════════════════
//  7. GORSEL
// ═══════════════════════════════════════════════════════════════════════════════
G7 = "7. Gorsel"

ribWidth  = input.int(3, "Serit Kalinligi", minval = 1, maxval = 6, group = G7)
showGlow  = input.bool(true, "Serit Altina Gradient Fill", group = G7)
glowMult  = input.float(0.35, "Fill Kalinligi (ATR x)", minval = 0.05, maxval = 2.0, step = 0.05, group = G7)
showBox   = input.bool(true, "Kutu Sinirlarini Ciz", group = G7)
showLbl   = input.bool(true, "Sinyal Etiketleri", group = G7)
showLvl   = input.bool(true, "Stop ve Hedef Cizgileri", group = G7)
showBars  = input.bool(false, "Mumlari Serit Rengiyle Boya", group = G7)
panelMode = input.string("Tablo", "Durum Paneli", options = ["Tablo", "Etiket", "Kapali"], group = G7, tooltip = "Tablo gorunmuyorsa Etiket secin — ayni bilgiyi son bara yazar.")

// ═══════════════════════════════════════════════════════════════════════════════
//  RENKLER
// ═══════════════════════════════════════════════════════════════════════════════
C_BULL = #26A69A
C_BEAR = #EF5350
C_FLAT = #787B86
C_SQ   = #FF9800
C_BOX  = #5D9CEC

// ═══════════════════════════════════════════════════════════════════════════════
//  CEKIRDEK FONKSIYONLAR  (dizi/dongu yok, fonksiyon ici gecmis yok)
// ═══════════════════════════════════════════════════════════════════════════════

// Hizalanma skoru: -100 (tam dusus dizilimi) ... +100 (tam yukselis dizilimi)
f_score() =>
    float e1 = ta.ema(close, len1)
    float e2 = ta.ema(close, len2)
    float e3 = ta.ema(close, len3)
    float e4 = ta.ema(close, len4)
    float e5 = ta.ema(close, len5)
    float e6 = ta.ema(close, len6)
    float e7 = ta.ema(close, len7)
    float pS = 0.0
    float pN = 0.0
    float oS = 0.0
    float oN = 0.0
    float pv = na
    if use1
        pS := pS + (close > e1 ? 1.0 : -1.0)
        pN := pN + 1.0
        pv := e1
    if use2
        pS := pS + (close > e2 ? 1.0 : -1.0)
        pN := pN + 1.0
        if not na(pv)
            oS := oS + (pv > e2 ? 1.0 : -1.0)
            oN := oN + 1.0
        pv := e2
    if use3
        pS := pS + (close > e3 ? 1.0 : -1.0)
        pN := pN + 1.0
        if not na(pv)
            oS := oS + (pv > e3 ? 1.0 : -1.0)
            oN := oN + 1.0
        pv := e3
    if use4
        pS := pS + (close > e4 ? 1.0 : -1.0)
        pN := pN + 1.0
        if not na(pv)
            oS := oS + (pv > e4 ? 1.0 : -1.0)
            oN := oN + 1.0
        pv := e4
    if use5
        pS := pS + (close > e5 ? 1.0 : -1.0)
        pN := pN + 1.0
        if not na(pv)
            oS := oS + (pv > e5 ? 1.0 : -1.0)
            oN := oN + 1.0
        pv := e5
    if use6
        pS := pS + (close > e6 ? 1.0 : -1.0)
        pN := pN + 1.0
        if not na(pv)
            oS := oS + (pv > e6 ? 1.0 : -1.0)
            oN := oN + 1.0
        pv := e6
    if use7
        pS := pS + (close > e7 ? 1.0 : -1.0)
        pN := pN + 1.0
        if not na(pv)
            oS := oS + (pv > e7 ? 1.0 : -1.0)
            oN := oN + 1.0
        pv := e7
    float pNorm = pN > 0 ? pS / pN * 100.0 : 0.0
    float oNorm = oN > 0 ? oS / oN * 100.0 : 0.0
    float wp = wPrice / 100.0
    pNorm * wp + oNorm * (1.0 - wp)

// Ekrana cizilen tek cizgi: aktif EMA'larin agirlikli ortalamasi
f_baseline() =>
    float e1 = ta.ema(close, len1)
    float e2 = ta.ema(close, len2)
    float e3 = ta.ema(close, len3)
    float e4 = ta.ema(close, len4)
    float e5 = ta.ema(close, len5)
    float e6 = ta.ema(close, len6)
    float e7 = ta.ema(close, len7)
    bool eq = wMode == "Esit"
    float w1 = eq ? 1.0 : 1.0 / len1
    float w2 = eq ? 1.0 : 1.0 / len2
    float w3 = eq ? 1.0 : 1.0 / len3
    float w4 = eq ? 1.0 : 1.0 / len4
    float w5 = eq ? 1.0 : 1.0 / len5
    float w6 = eq ? 1.0 : 1.0 / len6
    float w7 = eq ? 1.0 : 1.0 / len7
    float vs = 0.0
    float ws = 0.0
    if use1
        vs := vs + e1 * w1
        ws := ws + w1
    if use2
        vs := vs + e2 * w2
        ws := ws + w2
    if use3
        vs := vs + e3 * w3
        ws := ws + w3
    if use4
        vs := vs + e4 * w4
        ws := ws + w4
    if use5
        vs := vs + e5 * w5
        ws := ws + w5
    if use6
        vs := vs + e6 * w6
        ws := ws + w6
    if use7
        vs := vs + e7 * w7
        ws := ws + w7
    ws > 0 ? vs / ws : close

// Repaint'siz HTF cagrisi (PineCoders standart kalibi)
f_sec(simple string _res, float _src) =>
    request.security(syminfo.tickerid, _res, noRepaint ? _src[1] : _src, lookahead = barmerge.lookahead_off)

f_state(float sc) =>
    sc >= thUp ? 1 : sc <= thDn ? -1 : 0

f_col(int st) =>
    st == 1 ? C_BULL : st == -1 ? C_BEAR : C_FLAT

f_txt(int st) =>
    st == 1 ? "YUKSELIS" : st == -1 ? "DUSUS" : "NOTR"

f_json(string act, string md, float px, float sl, float tp) =>
    '{"action":"' + act + '","mode":"' + md + '","ticker":"' + syminfo.ticker + '","exchange":"' + syminfo.prefix + '","tf":"' + timeframe.period + '","price":' + str.tostring(px, format.mintick) + ',"sl":' + str.tostring(sl, format.mintick) + ',"tp":' + str.tostring(tp, format.mintick) + '}'

// ═══════════════════════════════════════════════════════════════════════════════
//  MEVCUT TF HESAPLARI
// ═══════════════════════════════════════════════════════════════════════════════
float scoreCur = f_score()
float baseline = f_baseline()
float atrVal   = ta.atr(atrLen)
int   stCur    = f_state(scoreCur)

[diPlus, diMinus, adxVal] = ta.dmi(adxLen, adxSm)

// HTF sirasi kontrolu: HTF grafikten kucukse onay anlamsizdir. Eski surumde
// bu hata sessizce olusuyordu (4 saatlik grafikte HTF1=60), artik panelde yazar.
// timeframe.in_seconds() argumansiz cagrilinca grafigin kendi dilimini verir.
bool htfBad = timeframe.in_seconds(htf1) <= timeframe.in_seconds() or timeframe.in_seconds(htf2) <= timeframe.in_seconds(htf1)

float scoreH1 = f_sec(htf1, f_score())
float scoreH2 = f_sec(htf2, f_score())
int   stH1    = f_state(nz(scoreH1))
int   stH2    = f_state(nz(scoreH2))

// ═══════════════════════════════════════════════════════════════════════════════
//  KURUMSAL PARA AKISI  (hacimsiz sembollerde hata vermeyen elle hesaplar)
// ═══════════════════════════════════════════════════════════════════════════════
float rng   = high - low
float upV   = rng > 0 ? nz(volume) * (close - low) / rng : 0.0
float dnV   = rng > 0 ? nz(volume) * (high - close) / rng : 0.0
float cvd   = ta.cum(upV - dnV)
float cvdS  = ta.ema(cvd, cvdLen)
bool cvdBull = cvd > cvdS
bool cvdBear = cvd < cvdS

var float obvVal = 0.0
obvVal := obvVal + (close > nz(close[1], close) ? nz(volume) : close < nz(close[1], close) ? -nz(volume) : 0.0)
float obvS   = ta.ema(obvVal, obvLen)
bool obvBull = obvVal > obvS
bool obvBear = obvVal < obvS

float volAvg = ta.sma(volume, rvolLen)
bool rvolOk  = nz(volume) > nz(volAvg) * volMult

float mfSrc = hlc3
float posF  = ta.rma(mfSrc > nz(mfSrc[1], mfSrc) ? mfSrc * nz(volume) : 0.0, mfiLen)
float negF  = ta.rma(mfSrc < nz(mfSrc[1], mfSrc) ? mfSrc * nz(volume) : 0.0, mfiLen)
float mfiVal = posF + negF == 0 ? 50.0 : negF == 0 ? 100.0 : 100.0 - 100.0 / (1.0 + posF / negF)
bool mfiBull = mfiVal > 50
bool mfiBear = mfiVal < 50

bool newDay = timeframe.change("D")
var float cumPV = 0.0
var float cumV  = 0.0
if newDay
    cumPV := 0.0
    cumV  := 0.0
cumPV := cumPV + hlc3 * nz(volume)
cumV  := cumV + nz(volume)
float vwapVal = cumV > 0 ? cumPV / cumV : hlc3
bool vwapBull = close > vwapVal
bool vwapBear = close < vwapVal

int mfLong  = (useCvd and cvdBull ? 1 : 0) + (useObv and obvBull ? 1 : 0) + (useRvol and rvolOk ? 1 : 0) + (useMfi and mfiBull ? 1 : 0) + (useVwap and vwapBull ? 1 : 0)
int mfShort = (useCvd and cvdBear ? 1 : 0) + (useObv and obvBear ? 1 : 0) + (useRvol and rvolOk ? 1 : 0) + (useMfi and mfiBear ? 1 : 0) + (useVwap and vwapBear ? 1 : 0)

// Kalite puani: MTF uyumu (0-2) + para akisi onaylari (0-5) = 0-7
int qLong  = (stH1 == 1 ? 1 : 0) + (stH2 == 1 ? 1 : 0) + mfLong
int qShort = (stH1 == -1 ? 1 : 0) + (stH2 == -1 ? 1 : 0) + mfShort

// ═══════════════════════════════════════════════════════════════════════════════
//  REJIM VE KUTU
// ═══════════════════════════════════════════════════════════════════════════════
// Kutu siniri bir bar geriden alinir; boylece "kapanis kutunun disinda" sartı
// kendi kendini gecersiz kilmaz.
float boxTop = ta.highest(high, boxLook)[1]
float boxBot = ta.lowest(low, boxLook)[1]
float boxH   = boxTop - boxBot
bool  boxOk  = not na(boxTop) and not na(boxBot) and boxH > 0
bool  inBox  = boxOk and close <= boxTop and close >= boxBot

bool rangeRegime = useRegime and boxOk and not na(adxVal) and adxVal < adxTh and inBox
bool trendRegime = not rangeRegime
bool squeeze     = not na(adxVal) and adxVal < adxTh

// ── 1) RANGE: kenar fade ────────────────────────────────────────────────────
float edge = boxOk ? boxH * edgePct / 100.0 : na
bool atLow  = boxOk and low <= boxBot + edge
bool atHigh = boxOk and high >= boxTop - edge
bool rgLong  = useRange and rangeRegime and atLow and close > boxBot + edge * 0.5 and close > open
bool rgShort = useRange and rangeRegime and atHigh and close < boxTop - edge * 0.5 and close < open

// ── 2) BREAKOUT: kutu disina KAPANIS + hacim ────────────────────────────────
bool boUpRaw = boxOk and close > boxTop and rvolOk
bool boDnRaw = boxOk and close < boxBot and rvolOk
bool boLong  = useBreak and boUpRaw and not boUpRaw[1]
bool boShort = useBreak and boDnRaw and not boDnRaw[1]

// ── 3) TREND: serit ─────────────────────────────────────────────────────────
bool flipUp = stCur == 1 and nz(stCur[1]) != 1
bool flipDn = stCur == -1 and nz(stCur[1]) != -1
int  fUpAgo = nz(ta.barssince(flipUp), 9999)
int  fDnAgo = nz(ta.barssince(flipDn), 9999)
bool sqBlock = useSqTrend and squeeze
bool trLong  = useTrend and trendRegime and not sqBlock and stCur == 1 and fUpAgo <= flipWindow and qLong >= qualityMin
bool trShort = useTrend and trendRegime and not sqBlock and stCur == -1 and fDnAgo <= flipWindow and qShort >= qualityMin

// ── Birlesik sinyaller ──────────────────────────────────────────────────────
bool longSig  = allowLong and (rgLong or boLong or trLong)
bool shortSig = allowShort and (rgShort or boShort or trShort)
string sigMode = boLong or boShort ? "BREAKOUT" : rgLong or rgShort ? "RANGE" : "TREND"

// Her modun kendi stop/hedef seviyesi
float sigStop = na
float sigTp   = na
if rgLong
    sigStop := boxBot - atrVal * stopPad
    sigTp := boxTop
if rgShort
    sigStop := boxTop + atrVal * stopPad
    sigTp := boxBot
if boLong
    sigStop := boxTop - atrVal * stopPad
    sigTp := close + boxH
if boShort
    sigStop := boxBot + atrVal * stopPad
    sigTp := close - boxH
if trLong
    sigStop := close - atrVal * atrMult
    sigTp := close + atrVal * atrMult * rrRatio
if trShort
    sigStop := close + atrVal * atrMult
    sigTp := close - atrVal * atrMult * rrRatio

// ═══════════════════════════════════════════════════════════════════════════════
//  EMIRLER
// ═══════════════════════════════════════════════════════════════════════════════
var float pendStop = na
var float pendTp   = na
var float pendAtr  = na
var string pendMode = "TREND"
if longSig or shortSig
    pendStop := sigStop
    pendTp := sigTp
    pendAtr := atrVal
    pendMode := sigMode

if longSig and (allowRev or strategy.position_size == 0)
    strategy.entry("LONG", strategy.long, comment = sigMode, alert_message = f_json("buy", sigMode, close, nz(sigStop), nz(sigTp)))

if shortSig and (allowRev or strategy.position_size == 0)
    strategy.entry("SHORT", strategy.short, comment = sigMode, alert_message = f_json("sell", sigMode, close, nz(sigStop), nz(sigTp)))

var float stopPx = na
var float tpPx   = na

int posSign = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
bool newPos = posSign != 0 and posSign != nz(posSign[1])

if newPos
    float entryPx = strategy.position_avg_price
    float a = nz(pendAtr, atrVal)
    if pendMode == "TREND"
        stopPx := posSign > 0 ? entryPx - a * atrMult : entryPx + a * atrMult
        float risk = math.abs(entryPx - stopPx)
        tpPx := posSign > 0 ? entryPx + risk * rrRatio : entryPx - risk * rrRatio
    else
        stopPx := pendStop
        tpPx := pendTp

if posSign == 0
    stopPx := na
    tpPx := na

float tActTicks = atrVal * trailAct / syminfo.mintick
float tOffTicks = atrVal * trailOff / syminfo.mintick

if strategy.position_size > 0
    strategy.exit("L-Exit", from_entry = "LONG", stop = stopPx, limit = tpPx, trail_points = useTrail ? tActTicks : na, trail_offset = useTrail ? tOffTicks : na, alert_message = f_json("close_long", pendMode, close, nz(stopPx), nz(tpPx)))

if strategy.position_size < 0
    strategy.exit("S-Exit", from_entry = "SHORT", stop = stopPx, limit = tpPx, trail_points = useTrail ? tActTicks : na, trail_offset = useTrail ? tOffTicks : na, alert_message = f_json("close_short", pendMode, close, nz(stopPx), nz(tpPx)))

// ═══════════════════════════════════════════════════════════════════════════════
//  TESHIS: sinyali kim engelliyor?
// ═══════════════════════════════════════════════════════════════════════════════
int  qNow = stCur == 1 ? qLong : stCur == -1 ? qShort : 0
int  fAgo = stCur == 1 ? fUpAgo : stCur == -1 ? fDnAgo : 9999
string blocker = posSign != 0 ? "POZISYONDA" : not boxOk ? "VERI ISINIYOR" : rangeRegime ? (atLow or atHigh ? "KENARDA - onay bekleniyor" : "ORTA BOLGE - islem yok") : sqBlock ? "SIKISMA (TREND kapali)" : stCur == 0 ? "SKOR NOTR" : fAgo > flipWindow ? "DONUS ESKI (" + str.tostring(fAgo) + " bar)" : qNow < qualityMin ? "KALITE " + str.tostring(qNow) + "/" + str.tostring(qualityMin) : "HAZIR"

// ═══════════════════════════════════════════════════════════════════════════════
//  GORSELLESTIRME
// ═══════════════════════════════════════════════════════════════════════════════
color ribCol = f_col(stCur)

plotBase = plot(baseline, "Kurumsal Serit", color = ribCol, linewidth = ribWidth)
plotG1 = plot(showGlow ? baseline - atrVal * glowMult * 0.4 : na, "Fill 1", color = color.new(ribCol, 100), editable = false)
plotG2 = plot(showGlow ? baseline - atrVal * glowMult : na, "Fill 2", color = color.new(ribCol, 100), editable = false)
fill(plotBase, plotG1, color = color.new(ribCol, 80), title = "Golge 1")
fill(plotG1, plotG2, color = color.new(ribCol, 90), title = "Golge 2")

plot(showBox and boxOk ? boxTop : na, "Kutu Ust", color = color.new(C_BOX, 25), style = plot.style_linebr, linewidth = 1)
plot(showBox and boxOk ? boxBot : na, "Kutu Alt", color = color.new(C_BOX, 25), style = plot.style_linebr, linewidth = 1)

plot(showLvl and posSign != 0 ? stopPx : na, "Stop", color = color.new(C_BEAR, 20), style = plot.style_linebr, linewidth = 1)
plot(showLvl and posSign != 0 ? tpPx : na, "Hedef", color = color.new(C_BULL, 20), style = plot.style_linebr, linewidth = 1)

barcolor(showBars ? ribCol : na, title = "Mum Rengi")
bgcolor(rangeRegime ? color.new(C_SQ, 94) : na, title = "RANGE Rejimi")

plotshape(showLbl and longSig, title = "LONG", style = shape.labelup, location = location.belowbar, color = C_BULL, textcolor = color.white, text = "LONG", size = size.small)
plotshape(showLbl and shortSig, title = "SHORT", style = shape.labeldown, location = location.abovebar, color = C_BEAR, textcolor = color.white, text = "SHORT", size = size.small)

// ═══════════════════════════════════════════════════════════════════════════════
//  DURUM PANELI
//  Onceki surumde tablo render olmuyordu. Burada en sade kalip kullanildi:
//  konum SABIT (ternary ile verilmiyor), hucreler barstate.islast altinda.
//  Tablo yine gorunmezse Gorsel grubundan "Etiket" moduna gecin.
// ═══════════════════════════════════════════════════════════════════════════════
string regTxt = rangeRegime ? "RANGE" : "TREND"

var table pnl = table.new(position.top_right, 2, 11, border_width = 1)

if panelMode == "Tablo" and barstate.islast
    table.cell(pnl, 0, 0, "IFR TRADER", bgcolor = color.new(color.black, 10), text_color = color.white, text_size = size.small)
    table.cell(pnl, 1, 0, timeframe.period, bgcolor = color.new(color.black, 10), text_color = color.white, text_size = size.small)
    table.cell(pnl, 0, 1, "Rejim", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = size.small)
    table.cell(pnl, 1, 1, regTxt, bgcolor = color.new(rangeRegime ? C_SQ : C_BULL, 40), text_color = color.white, text_size = size.small)
    table.cell(pnl, 0, 2, "Serit", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = size.small)
    table.cell(pnl, 1, 2, f_txt(stCur), bgcolor = f_col(stCur), text_color = color.white, text_size = size.small)
    table.cell(pnl, 0, 3, "Skor", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = size.small)
    table.cell(pnl, 1, 3, str.tostring(scoreCur, "#.#"), bgcolor = color.new(f_col(stCur), 55), text_color = color.white, text_size = size.small)
    table.cell(pnl, 0, 4, "HTF " + htf1 + " / " + htf2, bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = size.small)
    table.cell(pnl, 1, 4, f_txt(stH1) + " / " + f_txt(stH2), bgcolor = color.new(color.gray, 60), text_color = color.white, text_size = size.small)
    table.cell(pnl, 0, 5, "Kalite L/S", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = size.small)
    table.cell(pnl, 1, 5, str.tostring(qLong) + " / " + str.tostring(qShort) + "  (min " + str.tostring(qualityMin) + ")", bgcolor = color.new(qLong >= qualityMin ? C_BULL : qShort >= qualityMin ? C_BEAR : C_FLAT, 45), text_color = color.white, text_size = size.small)
    table.cell(pnl, 0, 6, "Kutu", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = size.small)
    table.cell(pnl, 1, 6, boxOk ? str.tostring(boxBot, format.mintick) + " - " + str.tostring(boxTop, format.mintick) : "-", bgcolor = color.new(C_BOX, 60), text_color = color.white, text_size = size.small)
    table.cell(pnl, 0, 7, "ADX", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = size.small)
    table.cell(pnl, 1, 7, str.tostring(adxVal, "#.#") + (diPlus > diMinus ? "  +DI" : "  -DI"), bgcolor = color.new(diPlus > diMinus ? C_BULL : C_BEAR, 55), text_color = color.white, text_size = size.small)
    table.cell(pnl, 0, 8, "Pozisyon", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = size.small)
    table.cell(pnl, 1, 8, posSign > 0 ? "LONG " + pendMode : posSign < 0 ? "SHORT " + pendMode : "YOK", bgcolor = color.new(f_col(posSign), 45), text_color = color.white, text_size = size.small)
    table.cell(pnl, 0, 9, "HTF Kontrol", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = size.small)
    table.cell(pnl, 1, 9, htfBad ? "HATALI - HTF grafikten kucuk" : "OK", bgcolor = color.new(htfBad ? C_BEAR : C_BULL, 45), text_color = color.white, text_size = size.small)
    table.cell(pnl, 0, 10, "ENGEL", bgcolor = color.new(color.gray, 80), text_color = color.white, text_size = size.small)
    table.cell(pnl, 1, 10, blocker, bgcolor = color.new(blocker == "HAZIR" ? C_BULL : C_FLAT, 45), text_color = color.white, text_size = size.small)

// Tablo alternatifi: ayni bilgiyi son bara etiket olarak yazar
var label lb = na
if panelMode == "Etiket" and barstate.islast
    label.delete(lb)
    lb := label.new(bar_index, high, "IFR TRADER  " + timeframe.period + "\nRejim: " + regTxt + "\nSerit: " + f_txt(stCur) + "  (" + str.tostring(scoreCur, "#.#") + ")" + "\nHTF " + htf1 + "/" + htf2 + ": " + f_txt(stH1) + " / " + f_txt(stH2) + "\nKalite L/S: " + str.tostring(qLong) + " / " + str.tostring(qShort) + "  min " + str.tostring(qualityMin) + "\nKutu: " + (boxOk ? str.tostring(boxBot, format.mintick) + " - " + str.tostring(boxTop, format.mintick) : "-") + "\nADX: " + str.tostring(adxVal, "#.#") + "\nHTF Kontrol: " + (htfBad ? "HATALI" : "OK") + "\nENGEL: " + blocker, style = label.style_label_left, color = color.new(color.black, 15), textcolor = color.white, size = size.small)

// ═══════════════════════════════════════════════════════════════════════════════
//  ALARMLAR  ("Any alert() function call" ile kullanin)
// ═══════════════════════════════════════════════════════════════════════════════
if longSig
    alert(f_json("buy", sigMode, close, nz(sigStop), nz(sigTp)), alert.freq_once_per_bar_close)

if shortSig
    alert(f_json("sell", sigMode, close, nz(sigStop), nz(sigTp)), alert.freq_once_per_bar_close)
